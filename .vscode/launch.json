{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Depurar el visor",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "src/suficiencia/ui/visor.py"
      ],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "justMyCode": true
    },
    {
      "name": "Depurar la demostración del protocolo",
      "type": "debugpy",
      "request": "launch",
      "module": "suficiencia.cli",
      "args": [
        "protocolo",
        "demostracion"
      ],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "justMyCode": true,
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    }
  ]
}
